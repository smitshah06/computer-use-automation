# LLM keys are needed for DISCOVERY only. Replay runs with no key at all.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Which provider the discovery loop uses: anthropic | openai
SCRIBE_PROVIDER=anthropic
# Optional model overrides (defaults: claude-sonnet-4-6 / gpt-4o)
#SCRIBE_ANTHROPIC_MODEL=
#SCRIBE_OPENAI_MODEL=

# Secrets referenced by artifacts as {{secrets.*}} — resolved at runtime, never persisted.
SCRIBE_SECRET_TELLER_USERNAME=teller1
SCRIBE_SECRET_TELLER_PASSWORD=Demo!Pass1

# Operator console auth. Unset -> the CLI generates a random per-run token and prints the
# tokened console URL. Pin it ONLY when a script must call the console API in parallel
# (e.g. scripts/auto-approve.ts needs to share the run's token).
#SCRIBE_CONSOLE_TOKEN=
# Key for HMAC-signing operator dispositions (defaults to the console token).
#SCRIBE_SIGNING_SECRET=
