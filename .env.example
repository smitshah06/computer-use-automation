# LLM keys are needed for DISCOVERY only. Replay runs with no key at all.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Which provider the discovery loop uses: anthropic | openai
SCRIBE_PROVIDER=anthropic
# Optional model overrides (defaults: claude-sonnet-4-6 / gpt-4o)
#SCRIBE_ANTHROPIC_MODEL=
#SCRIBE_OPENAI_MODEL=

# Secrets referenced by artifacts as {{secrets.*}} — resolved at runtime, never persisted.
SCRIBE_SECRET_TELLER_USERNAME=teller1
SCRIBE_SECRET_TELLER_PASSWORD=Demo!Pass1
