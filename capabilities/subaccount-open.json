{
  "schemaVersion": "1.0",
  "capability": {
    "id": "subaccount-open",
    "version": "1.0.1",
    "name": "Open member sub-account",
    "description": "Open a new sub-account (Savings, Checking, or Holiday Club) for a member with a nickname and an initial deposit, submit the application, and return the confirmation number. Mutating: replay pauses for operator approval on the submit step (unattendedReplay=false)."
  },
  "target": {
    "appId": "cu-backoffice",
    "surface": "web",
    "entrypoint": "{{env.APP_BASE_URL}}/login",
    "appFingerprint": {
      "titlePattern": "CU BackOffice -",
      "markers": []
    }
  },
  "inputs": [
    {
      "name": "memberId",
      "type": "string",
      "required": true,
      "pattern": "^\\d+$",
      "sensitive": false,
      "example": "12345"
    },
    {
      "name": "accountType",
      "type": "string",
      "required": true,
      "pattern": "^(Savings|Checking|Holiday Club)$",
      "sensitive": false,
      "example": "Holiday Club"
    },
    {
      "name": "nickname",
      "type": "string",
      "required": true,
      "sensitive": false,
      "example": "Vacation Fund"
    },
    {
      "name": "depositAmount",
      "type": "string",
      "required": true,
      "pattern": "^\\d+(\\.\\d{2})?$",
      "sensitive": false,
      "example": "25.00"
    }
  ],
  "outputs": [
    {
      "name": "confirmationNumber",
      "type": "string",
      "sensitive": false,
      "sourceStep": "s14"
    }
  ],
