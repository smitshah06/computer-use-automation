{
  "schemaVersion": "1.0",
  "capability": {
    "id": "member-standing-check",
    "version": "1.0.0",
    "name": "Member standing check",
    "description": "Verify a member's standing: search for the member by member number, open the member's profile page, and read both the member's Status and the Member Since date from the profile. Both values must come from the profile page itself, not the search results."
  },
  "target": {
    "appId": "cu-backoffice",
    "surface": "web",
    "entrypoint": "{{env.APP_BASE_URL}}/login",
    "appFingerprint": {
      "titlePattern": "CU BackOffice -",
      "markers": []
    }
  },
  "inputs": [
    {
      "name": "memberId",
      "type": "string",
      "required": true,
      "pattern": "^\\d+$",
      "sensitive": false,
      "example": "12345"
    }
  ],
  "outputs": [
    {
      "name": "memberStatus",
      "type": "string",
      "sensitive": false,
      "sourceStep": "s9"
    },
    {
      "name": "memberSince",
      "type": "date",
      "sensitive": false,
      "sourceStep": "s10"
    }
  ],
