<%- include('partials/top', { title: 'Teller Sign-In', nav: false, notice: false }) %>
<table width="100%" border="0" cellpadding="0" cellspacing="0"><tr><td align="center">
  <table border="0" cellpadding="10" cellspacing="0" style="margin-top:60px">
    <tr><td bgcolor="#FFFFFF" style="border:1px solid #9AA7B8">
      <table border="0" cellpadding="6" cellspacing="0">
        <tr><td colspan="2" bgcolor="#16325C" align="center">
          <font face="Tahoma" size="2" color="#FFFFFF"><b>Teller Sign-In</b></font>
        </td></tr>
        <% if (expired) { %>
        <tr><td colspan="2"><font face="Tahoma" size="2" color="#B00020">Your session has expired. Please sign in again.</font></td></tr>
        <% } %>
        <% if (error) { %>
        <tr><td colspan="2"><font face="Tahoma" size="2" color="#B00020"><%= error %></font></td></tr>
        <% } %>
        <form method="POST" action="/login">
        <tr>
          <td align="right"><font face="Tahoma" size="2"><label for="ctl00_LoginCtl_txtUser">Teller ID</label></font></td>
          <td><input type="text" id="ctl00_LoginCtl_txtUser" name="user" size="18"></td>
        </tr>
        <tr>
          <td align="right"><font face="Tahoma" size="2"><label for="ctl00_LoginCtl_txtPass">Passcode</label></font></td>
          <td><input type="password" id="ctl00_LoginCtl_txtPass" name="pass" size="18"></td>
        </tr>
        <tr>
          <td>&nbsp;</td>
          <td><input type="submit" id="ctl00_LoginCtl_btnGo" value="Sign In"></td>
        </tr>
        </form>
      </table>
    </td></tr>
  </table>
</td></tr></table>
<%- include('partials/bottom') %>
