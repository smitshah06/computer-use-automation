<%- include('partials/top', { title: t.s.signInTitle, nav: false, notice: false }) %>
<table width="100%" border="0" cellpadding="0" cellspacing="0"><tr><td align="center">
  <table border="0" cellpadding="10" cellspacing="0" style="margin-top:60px">
    <tr><td bgcolor="#FFFFFF" style="border:1px solid <%= t.c.grid %>">
      <table border="0" cellpadding="6" cellspacing="0">
        <tr><td colspan="2" bgcolor="<%= t.c.header %>" align="center">
          <font face="Tahoma" size="2" color="#FFFFFF"><b><%= t.s.signInTitle %></b></font>
        </td></tr>
        <% if (expired) { %>
        <tr><td colspan="2"><font face="Tahoma" size="2" color="#B00020">Your session has expired. Please sign in again.</font></td></tr>
        <% } %>
        <% if (error) { %>
        <tr><td colspan="2"><font face="Tahoma" size="2" color="#B00020"><%= error %></font></td></tr>
        <% } %>
        <form method="POST" action="/login">
        <tr>
          <td align="right"><font face="Tahoma" size="2"><label for="<%= t.id.loginUser %>"><%= t.s.userLabel %></label></font></td>
          <td><input type="text" id="<%= t.id.loginUser %>" name="user" size="18"></td>
        </tr>
        <tr>
          <td align="right"><font face="Tahoma" size="2"><label for="<%= t.id.loginPass %>"><%= t.s.passLabel %></label></font></td>
          <td><input type="password" id="<%= t.id.loginPass %>" name="pass" size="18"></td>
        </tr>
        <tr>
          <td>&nbsp;</td>
          <td><input type="submit" id="<%= t.id.loginGo %>" value="<%= t.s.signInBtn %>"></td>
        </tr>
        </form>
      </table>
    </td></tr>
  </table>
</td></tr></table>
<%- include('partials/bottom') %>
