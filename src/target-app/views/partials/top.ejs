<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN">
<html>
<head>
<title><%= t.brand %> - <%= title %></title>
<% if (typeof refresh !== 'undefined' && refresh) { %><meta http-equiv="refresh" content="<%= refresh %>"><% } %>
</head>
<body bgcolor="<%= t.c.page %>" style="margin:0" link="<%= t.c.header %>" vlink="<%= t.c.header %>">
<table width="100%" border="0" cellpadding="5" cellspacing="0">
  <tr>
    <td bgcolor="<%= t.c.header %>">
      <font face="Tahoma" size="3" color="#FFFFFF"><b><%= t.brand %></b></font>
      <font face="Tahoma" size="1" color="<%= t.c.taglineFg %>">&nbsp;&nbsp;<%= t.tagline %></font>
    </td>
  </tr>
</table>
<% if (nav) { %>
<table width="100%" border="0" cellpadding="4" cellspacing="0">
  <tr>
    <td bgcolor="<%= t.c.band %>">
      <font face="Tahoma" size="2">
        <a id="<%= t.id.navDesk %>" href="/desk"><%= t.s.navDesk %></a>&nbsp;|&nbsp;
        <a id="<%= t.id.navSearch %>" href="/members"><%= t.s.navSearch %></a>&nbsp;|&nbsp;
        <a id="<%= t.id.navReports %>" href="#">Reports</a>&nbsp;|&nbsp;
        <a id="<%= t.id.navOut %>" href="/logout"><%= t.s.navOut %></a>
      </font>
    </td>
  </tr>
</table>
<% } %>
<% if (typeof notice !== 'undefined' && notice) { %>
<div id="<%= t.id.noticePnl %>" role="dialog" aria-label="System Notice" style="position:fixed;left:0;top:0;width:100%;height:100%;background:#00000066;z-index:1000;">
  <table width="100%" height="100%" border="0"><tr><td align="center" valign="middle">
    <table bgcolor="#FFFFE1" cellpadding="14" cellspacing="0" style="border:2px solid #6E6E6E;"><tr><td align="center">
      <font face="Tahoma" size="2"><b>System Notice</b><br><br>
      Nightly maintenance window 02:00-02:15 ET.<br>Batch postings may be delayed.</font><br><br>
      <input type="button" id="<%= t.id.noticeOk %>" value="OK"
             onclick="document.getElementById('<%= t.id.noticePnl %>').style.display='none';return false;">
    </td></tr></table>
  </td></tr></table>
</div>
<% } %>
