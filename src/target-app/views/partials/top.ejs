<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN">
<html>
<head>
<title>CU BackOffice - <%= title %></title>
<% if (typeof refresh !== 'undefined' && refresh) { %><meta http-equiv="refresh" content="<%= refresh %>"><% } %>
</head>
<body bgcolor="#EDEFF2" style="margin:0" link="#16325C" vlink="#16325C">
<table width="100%" border="0" cellpadding="5" cellspacing="0">
  <tr>
    <td bgcolor="#16325C">
      <font face="Tahoma" size="3" color="#FFFFFF"><b>CU BackOffice</b></font>
      <font face="Tahoma" size="1" color="#B9C6D8">&nbsp;&nbsp;Core Teller System v3.8.14</font>
    </td>
  </tr>
</table>
<% if (nav) { %>
<table width="100%" border="0" cellpadding="4" cellspacing="0">
  <tr>
    <td bgcolor="#D6DEEA">
      <font face="Tahoma" size="2">
        <a id="ctl00_Nav_lnkDesk" href="/desk">Teller Desk</a>&nbsp;|&nbsp;
        <a id="ctl00_Nav_lnkSearch" href="/members">Member Search</a>&nbsp;|&nbsp;
        <a id="ctl00_Nav_lnkReports" href="#">Reports</a>&nbsp;|&nbsp;
        <a id="ctl00_Nav_lnkOut" href="/logout">Sign Out</a>
      </font>
    </td>
  </tr>
</table>
<% } %>
<% if (typeof notice !== 'undefined' && notice) { %>
<div id="ctl00_Notice_pnl" role="dialog" aria-label="System Notice" style="position:fixed;left:0;top:0;width:100%;height:100%;background:#00000066;z-index:1000;">
  <table width="100%" height="100%" border="0"><tr><td align="center" valign="middle">
    <table bgcolor="#FFFFE1" cellpadding="14" cellspacing="0" style="border:2px solid #6E6E6E;"><tr><td align="center">
      <font face="Tahoma" size="2"><b>System Notice</b><br><br>
      Nightly maintenance window 02:00-02:15 ET.<br>Batch postings may be delayed.</font><br><br>
      <input type="button" id="ctl00_Notice_btnOk" value="OK"
             onclick="document.getElementById('ctl00_Notice_pnl').style.display='none';return false;">
    </td></tr></table>
  </td></tr></table>
</div>
<% } %>
